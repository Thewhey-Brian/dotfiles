# ~/.secrets — API keys and tokens, sourced by ~/.zshrc. Never commit the real file.
# Create it with:  cp ~/dotfiles/zsh/secrets.example ~/.secrets && chmod 600 ~/.secrets
# then uncomment and fill in only the ones you use. (Values come from the old
# machine, 1Password, or each service's dashboard — never from the repo.)
#
# Logins that store their own token don't need an entry here:
#   GitHub (gh auth login), Hugging Face (hf auth login), Claude, Codex.

# Hugging Face — only if a tool needs the env var; `hf auth login` is enough otherwise
# export HF_TOKEN=

# Model APIs
# export OPENAI_API_KEY=
# export GEMINI_API_KEY=
# export ELEVENLABS_API_KEY=

# Google
# export GOOGLE_PLACES_API_KEY=

# Market data (quant)
# export ALPACA_API_KEY=
# export ALPACA_SECRET_KEY=
# export FINNHUB_API_KEY=
# export POLYGON_API_KEY=
# export FRED_API_KEY=
