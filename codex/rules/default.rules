prefix_rule(pattern=["xcodebuild"], decision="allow")
prefix_rule(pattern=["pnpm", "build"], decision="allow")
prefix_rule(pattern=["pnpm", "dev"], decision="allow")
prefix_rule(pattern=["rm", ".next/dev/lock"], decision="allow")
prefix_rule(pattern=["curl", "-I", "http://localhost:3001/login"], decision="allow")
prefix_rule(pattern=["rm", "-rf", ".next/dev"], decision="allow")
prefix_rule(pattern=["ps", "-axo", "pid,command"], decision="allow")
prefix_rule(pattern=["docker", "ps"], decision="allow")
prefix_rule(pattern=["npm", "install"], decision="allow")
prefix_rule(pattern=["rm", "-rf", "node_modules/lucide-react"], decision="allow")
prefix_rule(pattern=["python3", "-m", "venv", ".venv"], decision="allow")
prefix_rule(pattern=[".venv/bin/pip", "install"], decision="allow")
prefix_rule(pattern=["docker", "compose", "up"], decision="allow")
prefix_rule(pattern=["open", "-a", "Docker"], decision="allow")
prefix_rule(pattern=["docker", "info"], decision="allow")
prefix_rule(pattern=["docker", "compose", "ps"], decision="allow")
prefix_rule(pattern=["curl", "-sS"], decision="allow")
